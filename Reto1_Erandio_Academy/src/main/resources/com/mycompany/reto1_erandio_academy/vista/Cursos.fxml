<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contenido" prefHeight="550.0" prefWidth="850.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.reto1_erandio_academy.vista.CursosController">

    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colDescripcion" text="Descripción"/>
            <TableColumn fx:id="colDuracion" text="Duración"/>
            <TableColumn fx:id="colActivo" text="Activo"/>
        </columns>
    </TableView>

    <Button fx:id="nuevo" text="Registrar curso" onAction="#onNuevo"/>
    <Button fx:id="modificar" text="Modificar curso" onAction="#onModificar"/>
    <Button fx:id="eliminar" text="Eliminar curso" onAction="#onEliminar"/>
    <Button fx:id="actualizar" text="Actualizar lista" onAction="#onActualizar"/>
</VBox>
