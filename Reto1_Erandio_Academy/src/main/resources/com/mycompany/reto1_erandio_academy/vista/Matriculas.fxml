<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contenido" prefHeight="600.0" prefWidth="850.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.reto1_erandio_academy.vista.MatriculasController">

    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>

    <Label fx:id="titulo" text="GESTIÓN DE MATRÍCULAS"/>

    <VBox fx:id="bloqueAdmin" spacing="10.0" visible="false" managed="false">
        <Label text="Seleccionar usuario:"/>
        <ComboBox fx:id="usuarios" promptText="Selecciona un usuario"/>
        <Label text="Seleccionar curso:"/>
        <ComboBox fx:id="cursos" promptText="Selecciona un curso"/>
        <Button fx:id="matricular" text="Matricular usuario" onAction="#onMatricular"/>
    </VBox>

    <Label text="Matrículas registradas:"/>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="usuarioColumna" prefWidth="180.0" text="Usuario"/>
            <TableColumn fx:id="cursoColumna" prefWidth="200.0" text="Curso"/>
            <TableColumn fx:id="fechaColumna" prefWidth="130.0" text="Fecha"/>
            <TableColumn fx:id="estadoColumna" prefWidth="120.0" text="Estado"/>
        </columns>
    </TableView>

    <Button fx:id="actualizar" text="Actualizar lista" onAction="#onActualizar"/>
    <Button fx:id="eliminar" text="Dar de baja" onAction="#onEliminar" visible="false" managed="false"/>
</VBox>
