<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contenido" prefHeight="600.0" prefWidth="750.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.reto1_erandio_academy.vista.ActividadesController">

    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>

    <Label fx:id="avisoSinCursos" visible="false" managed="false" wrapText="true"
           text="No tienes ningún curso asignado todavía. Pide al administrador que te asigne uno."/>

    <Label text="Seleccionar curso:"/>
    <ComboBox fx:id="cursos" promptText="Selecciona un curso"/>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitulo" text="Título"/>
            <TableColumn fx:id="colDescripcion" text="Descripción"/>
            <TableColumn fx:id="colNumEjercicios" text="Ejercicios"/>
        </columns>
    </TableView>

    <Button fx:id="nuevo" text="Nueva actividad" onAction="#onNueva"/>
    <Button fx:id="modificar" text="Modificar actividad" onAction="#onModificar"/>
    <Button fx:id="eliminar" text="Eliminar actividad" onAction="#onEliminar"/>
    <Button fx:id="actualizar" text="Actualizar lista" onAction="#onActualizar"/>
</VBox>
