<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contenido" prefHeight="750.0" prefWidth="750.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.reto1_erandio_academy.vista.ValoracionesController">

    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/></padding>

    <Label fx:id="titulo" text="VALORAR CURSO"/>

    <VBox fx:id="bloqueAdminUsuario" spacing="8.0" visible="false" managed="false">
        <Label text="Seleccionar usuario:"/>
        <ComboBox fx:id="comboUsuarios" prefWidth="300.0"/>
    </VBox>

    <Label fx:id="etiquetaUsuarioPropio" visible="false" managed="false"/>

    <Label text="Seleccionar curso:"/>
    <ComboBox fx:id="comboCursos" prefWidth="300.0"/>

    <Label text="Puntuación (1 a 5):"/>
    <ComboBox fx:id="comboPuntuacion" promptText="Selecciona una puntuación"/>

    <Label text="Comentario:"/>
    <TextArea fx:id="campoComentario" prefRowCount="4" promptText="Escribe tu opinión sobre el curso..."/>

    <Button fx:id="botonGuardar" text="Guardar valoración" onAction="#onGuardar"/>

    <Label text="Valoraciones registradas:"/>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="usuarioColumna" prefWidth="140.0" text="Usuario"/>
            <TableColumn fx:id="cursoColumna" prefWidth="150.0" text="Curso"/>
            <TableColumn fx:id="puntuacionColumna" prefWidth="100.0" text="Puntuación"/>
            <TableColumn fx:id="comentarioColumna" prefWidth="250.0" text="Comentario"/>
        </columns>
    </TableView>

    <Button fx:id="botonActualizar" text="Actualizar valoraciones" onAction="#onActualizar"/>
</VBox>
