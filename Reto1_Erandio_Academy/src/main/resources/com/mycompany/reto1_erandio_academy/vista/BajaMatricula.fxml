<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contenido" prefHeight="550.0" prefWidth="650.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.reto1_erandio_academy.vista.BajaMatriculaController">

    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/></padding>

    <Label fx:id="titulo" text="DAR DE BAJA DE UN CURSO"/>
    <Label text="Seleccionar usuario:"/>
    <ComboBox fx:id="comboUsuarios" prefWidth="300.0"/>

    <TableView fx:id="tablaMatriculas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="columnaCurso" prefWidth="300.0" text="Curso ID"/>
            <TableColumn fx:id="columnaFecha" prefWidth="120.0" text="Fecha"/>
            <TableColumn fx:id="columnaEstado" prefWidth="120.0" text="Estado"/>
        </columns>
    </TableView>

    <Button fx:id="botonBaja" text="Darse de baja" onAction="#onBaja"/>
    <Button fx:id="botonActualizar" text="Actualizar lista" onAction="#onActualizar"/>
</VBox>
