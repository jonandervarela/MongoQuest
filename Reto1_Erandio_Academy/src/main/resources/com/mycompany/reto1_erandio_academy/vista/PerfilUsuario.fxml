<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contenido" prefHeight="450.0" prefWidth="450.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.reto1_erandio_academy.vista.PerfilUsuarioController">

    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/></padding>

    <Label fx:id="titulo" text="MI PERFIL"/>

    <Label text="Nombre:"/>
    <TextField fx:id="campoNombre"/>

    <Label text="Correo electrónico:"/>
    <TextField fx:id="campoEmail"/>

    <Label text="Teléfono:"/>
    <TextField fx:id="campoTelefono"/>

    <Button fx:id="botonActualizar" text="Actualizar perfil" onAction="#onActualizar"/>
</VBox>
