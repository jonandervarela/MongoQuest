<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" prefHeight="650.0" prefWidth="1100.0" spacing="10.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.reto1_erandio_academy.vista.TareasController">

    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>

    <Label fx:id="tituloVentana" text="GESTIÓN DE TAREAS"/>

    <GridPane fx:id="formulario" hgap="10.0" vgap="10.0">
        <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>

        <Label text="Título:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="titulo" promptText="Título de la tarea" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Curso:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="curso" promptText="Selecciona uno de tus cursos" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Fecha límite:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <DatePicker fx:id="fecha" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <HBox spacing="10.0">
        <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>
        <Button fx:id="guardar" text="Crear tarea" onAction="#onGuardar"/>
        <Button fx:id="guardarCambios" text="Guardar cambios" onAction="#onGuardarCambios"/>
        <Button fx:id="editar" text="Editar seleccionada" onAction="#onEditar"/>
        <Button fx:id="eliminar" text="Eliminar tarea" onAction="#onEliminar"/>
        <Button fx:id="actualizar" text="Actualizar lista" onAction="#onActualizar"/>
        <Button fx:id="exportar" text="Exportar a Excel" onAction="#onExportar"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitulo" text="Título"/>
            <TableColumn fx:id="colProfesor" text="Profesor ID"/>
            <TableColumn fx:id="colCurso" text="Curso ID"/>
            <TableColumn fx:id="colFecha" text="Fecha límite"/>
        </columns>
    </TableView>
</VBox>
