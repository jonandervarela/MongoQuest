<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contenido" prefHeight="450.0" prefWidth="700.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.reto1_erandio_academy.vista.ListaUsuariosController">

    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colEmail" text="Email"/>
            <TableColumn fx:id="colTelefono" text="Teléfono"/>
        </columns>
    </TableView>

    <Button fx:id="modificar" text="Modificar usuario" onAction="#onModificar"/>
    <Button fx:id="eliminar" text="Eliminar usuario" onAction="#onEliminar"/>
    <Button fx:id="actualizar" text="Actualizar lista" onAction="#onActualizar"/>
</VBox>
